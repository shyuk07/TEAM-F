DATABASE_URL=postgresql+asyncpg://lastcall:lastcall_dev@localhost:5433/lastcall
JWT_SECRET_KEY=change-me-to-a-random-string-of-32-chars-or-more
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 선택: 서버 시작 시 관리자 계정을 보장합니다. 둘 다 설정하거나 둘 다 비워 두세요.
# 이미 관리자가 있으면 아무것도 하지 않습니다(비밀번호 갱신 없음).
# 같은 이메일의 비관리자 계정이 있으면 서버 시작이 중단됩니다.
# 비밀번호는 8자 이상 72바이트 이하이고 "change-me"로 시작하면 거부됩니다.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=<임의의 비밀번호>

# 상점 개설 시 주소를 좌표로 바꾸는 카카오 로컬 API(주소 검색). 비워 두면 서버는 뜨지만
# POST /v1/stores 가 503 GEOCODING_UNAVAILABLE 로 거절됩니다.
KAKAO_REST_API_KEY=
# 선택: 엔드포인트와 타임아웃(초). 기본값은 stores 설계 15.2 참고
# KAKAO_GEOCODE_URL=https://dapi.kakao.com/v2/local/search/address.json
# KAKAO_TIMEOUT_SECONDS=5

# 비밀번호 재설정 코드를 메일로 보내는 SMTP. 전부 비워 두면 코드가 서버 로그에만 남습니다(개발용).
# 쓰려면 SMTP_HOST·SMTP_USER·SMTP_PASSWORD·MAIL_FROM을 모두 채웁니다. 일부만 채우면 서버가 시작하지 않습니다.
# STARTTLS(587)만 지원합니다. 465(암묵적 TLS)는 지원하지 않습니다.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
