DATABASE_URL=postgresql+asyncpg://lastcall:lastcall_dev@localhost:5433/lastcall
JWT_SECRET_KEY=change-me-to-a-random-string-of-32-chars-or-more
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 선택: 서버 시작 시 관리자 계정을 보장합니다. 둘 다 설정하거나 둘 다 비워 두세요.
# 이미 관리자가 있으면 아무것도 하지 않습니다(비밀번호 갱신 없음).
# 같은 이메일의 비관리자 계정이 있으면 서버 시작이 중단됩니다.
# 비밀번호는 8자 이상 72바이트 이하이고 "change-me"로 시작하면 거부됩니다.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=<임의의 비밀번호>

# 상점 개설 시 주소를 좌표로 바꾸는 네이버 지오코딩 (NCP Maps). 비워 두면 서버는 뜨지만
# POST /v1/stores 가 503 GEOCODING_UNAVAILABLE 로 거절됩니다.
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
# 선택: 엔드포인트와 타임아웃(초). 기본값은 stores 설계 14.2 참고
# NAVER_MAP_GEOCODE_URL=https://maps.apigw.ntruss.com/map-geocode/v2/geocode
# NAVER_MAP_TIMEOUT_SECONDS=5
