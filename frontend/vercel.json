{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://lastcall-api-ggzn.onrender.com/v1/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
